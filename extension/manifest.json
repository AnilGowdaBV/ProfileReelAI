{
  "manifest_version": 3,
  "name": "ProfileReel AI - LinkedIn Candidate Scorer",
  "version": "1.0.0",
  "description": "Instant 10-point AI candidate scoring and talent assessment directly on LinkedIn profiles.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProfileReel AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5174/*", "http://127.0.0.1:5174/*"],
      "js": ["plugin-guard.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost:5174/*", "http://127.0.0.1:5174/*"],
      "js": ["plugin-login.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost:3000/api/auth/linkedin/callback*", "http://127.0.0.1:3000/api/auth/linkedin/callback*"],
      "js": ["callback-handoff.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "windows",
    "webNavigation",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://profilereel-ai-backend.onrender.com/*",
    "http://localhost:3000/*",
    "http://localhost:5174/*",
    "http://127.0.0.1:5174/*",
    "http://127.0.0.1:3000/*",
    "https://*.linkedin.com/*",
    "https://*.instahyre.com/*"
  ]
}
